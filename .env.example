# Copy this file to `.env` (which is gitignored) before running `make up`.
#   cp .env.example .env
# docker compose reads `.env` automatically.

# Postgres credentials + database name
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders

# Host ports (left side of the "host:container" mapping in docker-compose.yml)
POSTGRES_PORT=5432
KAFKA_PORT=9092
ORDER_INGEST_PORT=8080
ORDER_QUERY_PORT=8081
