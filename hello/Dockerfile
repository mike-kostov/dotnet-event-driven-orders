# TODO(you) 4.1 — Start FROM a base image that already has the .NET 9 SDK.
#   This gives us the `dotnet` tooling to build the app.
#   hint: mcr.microsoft.com/dotnet/sdk:9.0
# FROM <base-image>

# TODO(you) 4.2 — Set the working directory inside the image to /app.
#   Every instruction after this runs relative to /app.
# WORKDIR <path>

# TODO(you) 4.3 — Copy the project source into the image, then publish a
#   Release build into /out.
# COPY <from> <to>
# RUN dotnet publish -c Release -o /out

# TODO(you) 4.4 — Tell the container what to run when it starts:
#   the published app, `dotnet /out/hello.dll`.
# ENTRYPOINT [ ... ]
