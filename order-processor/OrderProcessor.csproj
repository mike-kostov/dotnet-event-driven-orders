<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrderProcessor</RootNamespace>
  </PropertyGroup>

  <!-- The test project lives under tests/; keep its sources out of this app's build. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Raw Kafka client (ADR-0003). Owned per service. -->
    <PackageReference Include="Confluent.Kafka" Version="2.6.0" />
    <!-- Postgres access: Dapper + Npgsql, hand-written SQL (ADR-0009). Added in lesson 5. -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Observability: OpenTelemetry traces to the console (lesson 10). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.9.0" />
  </ItemGroup>

</Project>
